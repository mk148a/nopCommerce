@model ContactUsModel
@using Nop.Core.Domain.Seo
@using Nop.Plugin.Widgets.NopQuickTabsBugFix.Models
@inject Nop.Core.IWebHelper webHelper
@inject SeoSettings seoSettings


    @if (!Model.SuccessfullySent && !string.IsNullOrEmpty(Model.Result))
    {
        <div class="message-error">@Model.Result</div>
    }
    else
    {
        <form asp-action="ProductContactUsAddNew" asp-controller="NopQuickTabsBugFixs"  method="post">
            @{
            foreach (var items in @Context.Items)
                {
                    Console.WriteLine(items.Key+"/"+items.Value);
                }
            }
            <div asp-validation-summary="ModelOnly" class="message-error"></div>
            <div class="form-fields">
                <div class="inputs">
                    <label asp-for="FullName"></label>
                    <input asp-for="FullName" placeholder="@T("ContactUs.FullName.Hint")" class="contact_tab_fullname review-title"/>
                    <nop-required/>
                    <span asp-validation-for="FullName"></span>
                </div>
                <div class="inputs">
                    <label asp-for="Email"></label>
                    <input asp-for="Email" placeholder="@T("ContactUs.Email.Hint")" class="contact_tab_email review-title"/>
                    <nop-required/>
                    <span asp-validation-for="Email"></span>
                </div>
                @if (Model.SubjectEnabled)
                {
                    <div class="inputs">
                        <label asp-for="Subject" asp-postfix=":"></label>
                        <input asp-for="Subject" placeholder="@T("ContactUs.Subject.Hint")" class="contact_tab_subject subject"/>
                        <nop-required/>
                        <span asp-validation-for="Subject"></span>
                    </div>
                }
                <div class="inputs">
                    <label asp-for="Enquiry"></label>
                    <textarea asp-for="Enquiry" placeholder="@T("ContactUs.Enquiry.Hint")" class="contact_tab_enquiry review-text"></textarea>
                    <nop-required/>
                    <span asp-validation-for="Enquiry"></span>
                </div>

                @if (Model.DisplayCaptcha)
                {
                    <nop-captcha/>
                }
            </div>
            <div class="buttons">
                <button type="submit" name="send-email" class="button-1 contact-us-button">@T("ContactUs.Button")</button>
            </div>
        </form>

    }
   

