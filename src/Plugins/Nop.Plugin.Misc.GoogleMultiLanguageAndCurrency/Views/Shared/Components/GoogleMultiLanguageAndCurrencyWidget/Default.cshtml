@model Nop.Plugin.Misc.GoogleMultiLanguageAndCurrency.Models.GoogleMultiLanguageAndCurrencysModel
@{
    try
    {
        foreach (var linkTag in Model.LinkTags)
        {
            <link rel="@linkTag.Rel" hreflang="@linkTag.Hreflang" href="@linkTag.Href" />
        }
    }
    catch (Exception e)
    {
        Console.WriteLine(e);
        
    }
  
}
