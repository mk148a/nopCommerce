@model Nop.Plugin.Misc.EtsyToNopcommerce.Models.ConfigurationModel
@{
    Layout = "_ConfigurePlugin";
}

@await Component.InvokeAsync("StoreScopeConfiguration")

@*@if (Model.IsConfigured)
{
    @await Component.InvokeAsync("SettingMode")
}*@



<form asp-controller="EtsyToNopcommerce" asp-action="Configure" method="post">
    <div class="cards-group">
        <div class="card card-default">
            <div class="card-body">
                <p>
                    <h5>Etsy Tanımlamalarını Buradan Yapabilirsiniz</h5>
                    <br />
                </p>
                <hr />
                <p>Api Bilgileri</p>
                <div class="form-group row">
                    <div class="col-md-3">
                        <nop-override-store-checkbox asp-for="ShopName_OverrideForStore" asp-input="ShopName" asp-store-scope="@Model.ActiveStoreScopeConfiguration" />
                        <nop-label asp-for="ShopName"/>
                    </div>
                    <div class="col-md-9">
                        <nop-editor asp-for="ShopName" asp-required="true" />
                        <span asp-validation-for="ShopName"></span>
                    </div>
                </div>
                <div class="form-group row">
                    <div class="col-md-3">
                        <nop-override-store-checkbox asp-for="ShopId_OverrideForStore" asp-input="ShopId" asp-store-scope="@Model.ActiveStoreScopeConfiguration" />
                        <nop-label asp-for="ShopId"/>
                    </div>
                    <div class="col-md-9">
                        <nop-editor asp-for="ShopId" asp-required="false" />
                        <span asp-validation-for="ShopId"></span>
                    </div>
                </div>
                <div class="form-group row" type="hidden">
                    <div class="col-md-3">
                        <nop-override-store-checkbox asp-for="ConsumerKey_OverrideForStore" asp-input="ConsumerKey" asp-store-scope="@Model.ActiveStoreScopeConfiguration" />
                        <nop-label asp-for="ConsumerKey" />
                    </div>
                    <div class="col-md-9">
                        <nop-editor asp-for="ConsumerKey" asp-required="true" />
                        <span asp-validation-for="ConsumerKey"></span>
                    </div>
                </div>
                <div class="form-group row" hidden>
                    <div class="col-md-3">
                        <nop-override-store-checkbox asp-for="ConsumerSecret_OverrideForStore" asp-input="ConsumerSecret" asp-store-scope="@Model.ActiveStoreScopeConfiguration" />
                        <nop-label asp-for="ConsumerSecret" />
                    </div>
                    <div class="col-md-9">
                        <nop-editor asp-for="ConsumerSecret" asp-required="true" />
                        <span asp-validation-for="ConsumerSecret"></span>
                    </div>
                </div>
                <div class="form-group row" hidden>
                    <div class="col-md-3">
                        <nop-override-store-checkbox asp-for="RequestUrl_OverrideForStore" asp-input="RequestUrl" asp-store-scope="@Model.ActiveStoreScopeConfiguration" />
                        <nop-label asp-for="RequestUrl" />
                    </div>
                    <div class="col-md-9">
                        <nop-editor asp-for="RequestUrl" asp-required="true" />
                        <span asp-validation-for="RequestUrl"></span>
                    </div>
                </div>
                <div class="form-group row" hidden>
                    <div class="col-md-3">
                        <nop-override-store-checkbox asp-for="RequestAccessTokenUrl_OverrideForStore" asp-input="RequestAccessTokenUrl" asp-store-scope="@Model.ActiveStoreScopeConfiguration" />
                        <nop-label asp-for="RequestAccessTokenUrl" />
                    </div>
                    <div class="col-md-9">
                        <nop-editor asp-for="RequestAccessTokenUrl" asp-required="true" />
                        <span asp-validation-for="RequestAccessTokenUrl"></span>
                    </div>
                </div>
                <div class="form-group row" hidden>
                    <div class="col-md-3">
                        <nop-override-store-checkbox asp-for="Token_OverrideForStore" asp-input="Token" asp-store-scope="@Model.ActiveStoreScopeConfiguration" />
                        <nop-label asp-for="Token"/>
                    </div>
                    <div class="col-md-9">
                        <nop-editor asp-for="Token" asp-required="false" />
                        <span asp-validation-for="Token"></span>
                    </div>
                </div>
                <div class="form-group row" >
                    <div class="col-md-3">
                        <nop-override-store-checkbox asp-for="RefreshToken_OverrideForStore" asp-input="Token" asp-store-scope="@Model.ActiveStoreScopeConfiguration" />
                        <nop-label asp-for="RefreshToken"/>
                    </div>
                    <div class="col-md-9">
                        <nop-editor asp-for="RefreshToken" asp-required="false" />
                        <span asp-validation-for="RefreshToken"></span>
                    </div>
                </div>
                <div class="form-group row">
                    <div class="col-md-3">
                        <nop-override-store-checkbox asp-for="TokenDate_OverrideForStore" asp-input="TokenDate" asp-store-scope="@Model.ActiveStoreScopeConfiguration" />
                        <nop-label asp-for="TokenDate"/>
                    </div>
                    <div class="col-md-9">
                        <nop-editor asp-for="TokenDate" asp-required="false" />
                        <span asp-validation-for="TokenDate"></span>

                    </div>
                </div>
                <hr />

                <div class="form-group row">
                    <div class="col-md-9 offset-md-3">
                        <button type="submit" name="save" class="btn btn-primary">Kaydet</button>
                    </div>
                </div>
                <div class="form-group row">
                    <a class="btn btn-primary" asp-controller="EtsyToNopcommerce"
                       asp-action="Yetkilendir"
                       class="mr-3 text-primary"
                       data-toggle="tooltip" data-placement="top"
                       title="Yetkilendir"
                       data-original-title="Yetkilendir">
                        Yetkilendir
                    </a>
                </div>
            </div>
        </div>
    </div>
</form>



<form id="EtsyYorumlari" asp-controller="EtsyToNopcommerce" asp-action="Configure" method="post">
    <div class="cards-group">
        <div class="card card-default">
            <div class="card-body">
                <p>
                    <h5>Etsy Yorumlarini Buradan Görebilirsiniz</h5>
                    <br />
                </p>
                <hr />
                <p>Testt Bilgileri</p>
               
                <hr />
                <p>testet</p>

                <a asp-controller="EtsyToNopcommerce"
                   asp-action="EtsyYorumlariniCagir"
                   class="mr-3 text-primary"
                   data-toggle="tooltip" data-placement="top"
                   title="Etsy Yorumlarini Cagir"
                   data-original-title="Etsy Yorumlarini Cagir">
                    <i class="fa fa-home">
                        Etsy Yorumlarini Cagir
                    </i>
                </a>
                
            </div>
        </div>
    </div>
</form>
@await Component.InvokeAsync("EtsyReviews")