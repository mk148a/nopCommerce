@model List<PictureModel>
@using Nop.Web.Models.Media

@if (Model.Count > 0)
{

    <div class="picture-thumbs" id="main-review-img">
            @foreach (var picture in Model)
            {
            <div class="thumb-item">
                <a class="review-photo-link" href="@picture.FullSizeImageUrl" target="_blank" rel="noopener">
                    <img class="review-photo-thumb" src="@picture.ImageUrl" alt="@picture.AlternateText" title="@picture.Title" width="150" height="150" loading="lazy" decoding="async" />
                </a>
            </div>
            }
    </div>
    
    

}
