@model List<Nop.Plugin.Widgets.CustomProductReviews.Models.ProductReviewVideoModel>
@using Nop.Web.Models.Media

@functions {
    string HoodCprText(string key, string fallback)
    {
        var value = T(key).ToString();
        if (string.IsNullOrWhiteSpace(value) ||
            value.IndexOf("plugins.widgets.customproductreviews", System.StringComparison.OrdinalIgnoreCase) >= 0 ||
            value.IndexOf("customproductreviews", System.StringComparison.OrdinalIgnoreCase) >= 0)
        {
            return fallback;
        }

        return value;
    }
}

@{
    var videoNotSupported = HoodCprText("Plugins.Widgets.CustomProductReviews.VideoNotSupported", "Your browser does not support the video tag.");
    var reviewVideo = HoodCprText("Plugins.Widgets.CustomProductReviews.ReviewVideo", "Review video");
}

@if (Model.Count > 0)
{
    <div class="video-thumbs cpr-review-video-thumbs" id="main-review-vid">
        @foreach (var video in Model)
        {
            var src = video.ImageUrl ?? string.Empty;
            var contentType = src.Contains("webm", StringComparison.OrdinalIgnoreCase) ? "video/webm" : "video/mp4";
            <div class="video-container cpr-review-video-container">
                <video controls="controls"
                       class="embed-responsive-item cpr-review-video"
                       preload="metadata"
                       playsinline
                       width="640"
                       height="480"
                       aria-label="@reviewVideo">
                    <source src="@video.ImageUrl" type="@contentType" />
                    @videoNotSupported
                </video>
            </div>
        }
    </div>
}
