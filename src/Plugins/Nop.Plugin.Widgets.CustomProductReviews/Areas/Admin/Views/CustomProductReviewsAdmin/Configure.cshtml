@model Nop.Plugin.Widgets.CustomProductReviews.Areas.Admin.Models.ConfigurationModel

@{
    Layout = "_ConfigurePlugin";
}

<form asp-controller="CustomProductReviewsAdmin" asp-action="Configure" method="post">
    <div class="cards-group">
        <div class="card card-default">
            <div class="card-header">
                @T("Plugins.Widgets.CustomProductReviews.Configuration")
            </div>
            <div class="card-body">
                <div class="form-group row">
                    <div class="col-md-3">
                        <nop-label asp-for="WidgetZone" />
                    </div>
                    <div class="col-md-9">
                        <nop-editor asp-for="WidgetZone" />
                        <span asp-validation-for="WidgetZone"></span>
                    </div>
                </div>
                <div class="form-group row">
                    <div class="col-md-3">
                        <nop-label asp-for="MaximumFile" />
                    </div>
                    <div class="col-md-9">
                        <nop-editor asp-for="MaximumFile" />
                        <span asp-validation-for="MaximumFile"></span>
                    </div>
                </div>
                <div class="form-group row">
                    <div class="col-md-3">
                        <nop-label asp-for="MaximumSize" />
                    </div>
                    <div class="col-md-9">
                        <nop-editor asp-for="MaximumSize" />
                        <span asp-validation-for="MaximumSize"></span>
                        <div class="text-muted">Default/current large upload setting: 1073741824 bytes ≈ 1 GB.</div>
                    </div>
                </div>
                <div class="form-group row">
                    <div class="col-md-3">
                        <nop-label asp-for="PublicCompactReviewLayout" />
                    </div>
                    <div class="col-md-9">
                        <nop-editor asp-for="PublicCompactReviewLayout" />
                    </div>
                </div>
            </div>
        </div>

        <div class="card card-default">
            <div class="card-header">
                Admin product review list media
            </div>
            <div class="card-body">
                <div class="form-group row">
                    <div class="col-md-3">
                        <nop-label asp-for="AdminShowMediaOnProductReviewList" />
                    </div>
                    <div class="col-md-9">
                        <nop-editor asp-for="AdminShowMediaOnProductReviewList" />
                    </div>
                </div>
                <div class="form-group row">
                    <div class="col-md-3">
                        <nop-label asp-for="AdminMediaThumbSize" />
                    </div>
                    <div class="col-md-9">
                        <nop-editor asp-for="AdminMediaThumbSize" />
                        <span asp-validation-for="AdminMediaThumbSize"></span>
                    </div>
                </div>
                <div class="form-group row">
                    <div class="col-md-3">
                        <nop-label asp-for="AdminMediaMaxItemsPerReview" />
                    </div>
                    <div class="col-md-9">
                        <nop-editor asp-for="AdminMediaMaxItemsPerReview" />
                        <span asp-validation-for="AdminMediaMaxItemsPerReview"></span>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="form-group row">
        <div class="col-md-9 offset-md-3">
            <button type="submit" name="save" class="btn btn-primary">
                <i class="far fa-save"></i>
                @T("Admin.Common.Save")
            </button>
        </div>
    </div>
</form>
