@model Nop.Plugin.Payments.StripeApplePay.Models.PaymentErrorModel

@{
    Layout = "~/Views/Shared/_ColumnsOne.cshtml";
}

@if (Model.Warnings.Count > 0)
{
    var checkoutUrl = "";
                
               
    checkoutUrl = Url.RouteUrl("Checkout");
<div class="checkout-data">
   
  
</div>
<div class="page checkout-page order-completed-page">
   
    <div class="page-title">
            <h1>@T("Plugins.Payments.StripeApplePay.Fields.PaymentFailed")</h1>
        <h1>Payment Failed</h1>
    </div>
    <div class="page-body checkout-data">
        <div class="section order-completed">
            <div class="title">
            </div>
            <div class="details">
              
                    <div class="section confirm-order">
                        <h2>@T("Plugins.Payments.StripeApplePay.Fields.PaymentErrors")</h2>

                        @if (Model.Warnings.Count > 0)
                        {
                            <div class="message-error">
                                <ul>
                                    @foreach (var warning in Model.Warnings)
                                    {
                                        <li>@warning</li>
                                    }
                                </ul>
                            </div>
                        }
                    </div>
               
                
            </div>
            <div class="buttons">

                <button type="submit" class="button-1 productAddedToCartWindowCheckout" onclick="setLocation('@checkoutUrl');"><span>@T("ShoppingCart.Mini.ViewCart")</span></button>


            </div>
        </div>
   </div>
    </div>
}
