@using Nop.Services.Directory
@using Nop.Web.Framework.TagHelpers.Shared
@using Nop.Core
@using Microsoft.AspNetCore.Mvc.TagHelpers
@model Nop.Plugin.Payments.StripeApplePay.Models.PaymentInfoModel
@{
    Layout = "";
}

<h2>Payment Info</h2>

<div id="payment-request-button"></div>
<p id="message"></p>

@section Scripts {
    <script src="https://js.stripe.com/v3/"></script>
    <script>
        document.addEventListener("DOMContentLoaded", async function () {
            var stripe = Stripe('@Model.StripePublishableKey');

            var response = await fetch('@Url.Action("CreatePaymentIntent", "PaymentStripeApplePay")', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' }
            });

            var data = await response.json();
            var clientSecret = data.clientSecret;

            var elements = stripe.elements();
            var paymentRequest = stripe.paymentRequest({
                country: 'US',
                currency: 'usd',
                total: {
                    label: 'Total',
                    amount: @Model.OrderTotal * 100, // Total amount in cents
                },
                requestPayerName: true,
                requestPayerEmail: true,
            });

            var prButton = elements.create('paymentRequestButton', {
                paymentRequest: paymentRequest,
            });

            paymentRequest.canMakePayment().then(function (result) {
                if (result) {
                    prButton.mount('#payment-request-button');
                } else {
                    document.getElementById('payment-request-button').style.display = 'none';
                    document.getElementById('message').innerText = 'Apple Pay is not available.';
                }
            });

            paymentRequest.on('paymentmethod', function (ev) {
                fetch('@Url.Action("ConfirmPayment", "PaymentStripeApplePay")', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({
                        paymentMethodId: ev.paymentMethod.id,
                        paymentIntentId: clientSecret
                    })
                }).then(function (response) {
                    return response.json();
                }).then(function (confirmResult) {
                    if (confirmResult.error) {
                        ev.complete('fail');
                        document.getElementById('message').innerText = confirmResult.error.message;
                    } else {
                        ev.complete('success');
                        document.getElementById('message').innerText = 'Payment succeeded!';
                    }
                });
            });
        });
    </script>
}
