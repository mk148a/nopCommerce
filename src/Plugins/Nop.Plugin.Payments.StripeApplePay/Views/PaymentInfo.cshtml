@model Nop.Plugin.Payments.StripeApplePay.Models.PaymentInfoModel


<!script async src="https://js.stripe.com/v3/"></!script>
<div id="payment-request-button"></div>
<p id="message"></p>

<script>
    $(document).ready(function () {
        var stripe = Stripe('@Model.StripePublishableKey');

        var paymentRequest = stripe.paymentRequest({
            country: 'US',
            currency: 'usd',
            total: {
                label: 'Total',
                amount: @Model.OrderTotal * 100 // Total amount in cents
            },
            requestPayerName: true,
            requestPayerEmail: true,
            requestPayerPhone: true
        });

        var elements = stripe.elements();
        var prButton = elements.create('paymentRequestButton', {
            paymentRequest: paymentRequest
        });

        paymentRequest.canMakePayment().then(function (result) {
            if (result) {
                prButton.mount('#payment-request-button');
            } else {
                document.getElementById('payment-request-button').style.display = 'none';
                document.getElementById('message').innerText = 'Google Pay or Apple Pay is not available on this device.';
            }
        });

        paymentRequest.on('paymentmethod', function (ev) {
            fetch('@Url.Action("AuthorizePayment", "PaymentStripeApplePay")', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({
                    paymentMethodId: ev.paymentMethod.id,
                    amount: @Model.OrderTotal * 100,
                    currency: 'usd'
                })
            }).then(function (response) {
                return response.json();
            }).then(function (paymentIntent) {
                if (paymentIntent.error) {
                    ev.complete('fail');
                    document.getElementById('message').innerText = paymentIntent.error.message;
                } else {
                    document.getElementById('PaymentIntentId').value = paymentIntent.id;
                    ev.complete('success');
                    document.getElementById('message').innerText = 'Payment authorized, please confirm your order.';
                }
            });
        });
    });
</script>

<input type="hidden" id="PaymentMethodId" name="PaymentMethodId" />
<input type="hidden" id="PaymentIntentId" name="PaymentIntentId" />

@NopHtml.GenerateScripts(ResourceLocation.Footer)
