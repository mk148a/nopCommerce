@model Nop.Plugin.Payments.StripeApplePay.Models.PaymentInfoModel

<script>
    $(document).ready(function () {
        $.getScript('https://js.stripe.com/v3/', function () {
            var stripe = Stripe('@Model.StripePublishableKey');
            var elements = stripe.elements();

            var paymentRequest = stripe.paymentRequest({
                country: '@Model.Country',
                currency: '@Model.Currency',
                total: {
                    label: 'Total',
                    amount: Math.round(@Model.OrderTotal) // Total amount in cents
                },
                requestPayerName: true,
                requestPayerEmail: true,
            });

            var prButton = elements.create('paymentRequestButton', {
                paymentRequest: paymentRequest
            });

            paymentRequest.canMakePayment().then(function (result) {
                if (result) {
                    prButton.mount('#payment-request-button');
                } else {
                    $('#payment-request-button').hide();
                    $('#message').text('Apple Pay or Google Pay is currently unavailable. Please use Safari for Apple Pay or Chrome for Google Pay. Or add a payment method to your browser. For example, you can save a card in Chrome, add a card to your Google Pay account, or add a card to your Wallet for Safari.');
                }
            });

            paymentRequest.on('cancel', function () {
                // handle cancel event
            });

            paymentRequest.on('paymentmethod', function (ev) {
                $('#PaymentMethodId').val(ev.paymentMethod.id);
                ev.complete('success');
                $('#payment-request-button').hide();
                $('#message').text('Your payment method has been successfully selected. Please proceed to complete your order to finalize the payment.');
            });
        });
    });
</script>

<input type="hidden" id="PaymentMethodId" asp-for="PaymentMethodId" name="PaymentMethodId" />

<div id="payment-request-button"></div>
<div id="messages">
    <p id="message"></p>
</div>

<style>
    #opc-confirm_order .stripe-inline-payment-error {
        margin: 12px 0;
        padding: 12px 16px;
        border: 1px solid #d9534f;
        background: #fff5f5;
        color: #a94442;
    }
</style>

<script>
(function ($) {
    'use strict';

    var publishableKey = '@Model.StripePublishableKey';
    var threeDsPrefix = '__STRIPE_3DS__:';

    function showError(message) {
        var $host = $('#opc-confirm_order');
        if (!$host.length)
            $host = $('#checkout-step-confirm-order');
        if (!$host.length)
            return;
        $host.find('.stripe-inline-payment-error').remove();
        $('<div/>', { 'class': 'stripe-inline-payment-error', 'role': 'alert', 'text': message }).prependTo($host);
        if (window.Checkout && typeof window.Checkout.gotoSection === 'function')
            window.Checkout.gotoSection('confirm_order');
    }

    function loadStripe(callback) {
        if (typeof window.Stripe === 'function') {
            callback();
            return;
        }
        $.getScript('https://js.stripe.com/v3/').done(callback).fail(function () {
            showError('Additional card verification could not be loaded. Please try another payment method.');
        });
    }

    function handleThreeDs(payload) {
        var separator = payload.indexOf('|');
        var clientSecret = separator < 0 ? payload.substring(threeDsPrefix.length) : payload.substring(threeDsPrefix.length, separator);
        if (!clientSecret) {
            showError('Your bank requires additional verification. Please try again.');
            return;
        }
        showError('Your bank requires additional verification. Complete it here to finish your order.');
        loadStripe(function () {
            window.Stripe(publishableKey).handleCardAction(clientSecret).then(function (result) {
                if (result && result.error) {
                    showError(result.error.message || 'The verification was not completed. Please try again.');
                    return;
                }
                showError('Verification completed. Confirming your order...');
                if (window.ConfirmOrder && typeof window.ConfirmOrder.save === 'function')
                    window.ConfirmOrder.save();
            });
        });
    }

    function installInlineCheckoutHandler() {
        if (window.__hoodStripeInlineCheckoutInstalled)
            return;
        if (!window.ConfirmOrder || typeof window.ConfirmOrder.nextStep !== 'function') {
            window.setTimeout(installInlineCheckoutHandler, 50);
            return;
        }
        var originalNextStep = window.ConfirmOrder.nextStep;
        window.ConfirmOrder.nextStep = function (response) {
            if (response && response.error) {
                var message = $.isArray(response.message) ? response.message.join(' ') : String(response.message || response.error);
                if (message.indexOf(threeDsPrefix) === 0)
                    handleThreeDs(message);
                else
                    showError(message.replace(/^Payment error:\s*/i, ''));
                return false;
            }
            return originalNextStep.apply(this, arguments);
        };
        window.__hoodStripeInlineCheckoutInstalled = true;
    }

    $(installInlineCheckoutHandler);
})(jQuery);
</script>
