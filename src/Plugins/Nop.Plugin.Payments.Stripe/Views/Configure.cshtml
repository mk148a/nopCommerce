@model Nop.Plugin.Payments.Stripe.Models.ConfigurationModel
@{
    Layout = "_ConfigurePlugin";
}

<link rel="stylesheet" href="~/Plugins/Nop.Plugin.Payments.Stripe/Content/css/StripeAdminStyle.min.css" />

@await Component.InvokeAsync("StoreScopeConfiguration")

<form asp-controller="PaymentStripe" asp-action="Configure" method="post" autocomplete="off">
    <div class="cards-group">
        <div class="card card-default">
            <div class="card-body">
                <p>
                    <h5>@T("Plugins.Payments.Stripe.Instructions")</h5>
                    <br />
                </p>
                <hr />
                <p>@T("Plugins.Payments.Stripe.AccountInfo")</p>
                <div class="form-group row">
                    <div class="col-md-3">
                        <nop-override-store-checkbox asp-for="PublishableKey_OverrideForStore" asp-input="PublishableKey" asp-store-scope="@Model.ActiveStoreScopeConfiguration" />
                        <nop-label asp-for="PublishableKey" />
                    </div>
                    <div class="col-md-9">
                        <nop-editor asp-for="PublishableKey" asp-required="true" />
                        <span asp-validation-for="PublishableKey"></span>
                    </div>
                </div>
                <div class="form-group row">
                    <div class="col-md-3">
                        <nop-override-store-checkbox asp-for="SecretKey_OverrideForStore" asp-input="SecretKey" asp-store-scope="@Model.ActiveStoreScopeConfiguration" />
                        <nop-label asp-for="SecretKey" />
                    </div>
                    <div class="col-md-9">
                        <nop-editor asp-for="SecretKey" asp-required="true" />
                        <span asp-validation-for="SecretKey"></span>
                    </div>
                </div>

                <hr />
                <p><strong>Stripe test mode</strong></p>
                <p class="text-muted">Keep this disabled for live payments. When enabled, every server and browser Stripe request uses the test key pair below and test webhook credentials are kept separate from live credentials.</p>
                <div class="form-group row">
                    <div class="col-md-3">
                        <nop-override-store-checkbox asp-for="UseSandbox_OverrideForStore" asp-input="UseSandbox" asp-store-scope="@Model.ActiveStoreScopeConfiguration" />
                        <nop-label asp-for="UseSandbox" />
                    </div>
                    <div class="col-md-9">
                        <nop-editor asp-for="UseSandbox" />
                        <span asp-validation-for="UseSandbox"></span>
                    </div>
                </div>
                <div class="form-group row">
                    <div class="col-md-3">
                        <nop-override-store-checkbox asp-for="TestPublishableKey_OverrideForStore" asp-input="TestPublishableKey" asp-store-scope="@Model.ActiveStoreScopeConfiguration" />
                        <nop-label asp-for="TestPublishableKey" />
                    </div>
                    <div class="col-md-9">
                        <nop-editor asp-for="TestPublishableKey" asp-required="false" />
                        <span asp-validation-for="TestPublishableKey"></span>
                    </div>
                </div>
                <div class="form-group row">
                    <div class="col-md-3">
                        <nop-override-store-checkbox asp-for="TestSecretKey_OverrideForStore" asp-input="TestSecretKey" asp-store-scope="@Model.ActiveStoreScopeConfiguration" />
                        <nop-label asp-for="TestSecretKey" />
                    </div>
                    <div class="col-md-9">
                        <nop-editor asp-for="TestSecretKey" asp-required="false" />
                        <span class="text-muted">Leave blank to retain the saved test secret.</span>
                        <span asp-validation-for="TestSecretKey"></span>
                    </div>
                </div>

                <hr />
                <p><strong>Stripe webhook</strong></p>
                <p>
                    The public endpoint is signature-protected. Leave the password field empty to keep the stored signing secret unchanged.
                </p>
                <div class="form-group row">
                    <div class="col-md-3">
                        <nop-label asp-for="WebhookSecret" />
                    </div>
                    <div class="col-md-9">
                        <nop-editor asp-for="WebhookSecret" asp-required="false" />
                        @if (Model.WebhookSecretConfigured)
                        {
                            <span class="text-success">Configured</span>
                        }
                        else
                        {
                            <span class="text-warning">Not configured</span>
                        }
                        <span asp-validation-for="WebhookSecret"></span>
                    </div>
                </div>
                <div class="form-group row">
                    <div class="col-md-3">
                        <nop-label asp-for="WebhookEndpointUrl" />
                    </div>
                    <div class="col-md-9">
                        <input asp-for="WebhookEndpointUrl" class="form-control" readonly="readonly" />
                    </div>
                </div>
                <div class="form-group row">
                    <div class="col-md-3">
                        <nop-label asp-for="WebhookEndpointId" />
                    </div>
                    <div class="col-md-9">
                        <input asp-for="WebhookEndpointId" class="form-control" readonly="readonly" />
                    </div>
                </div>
                <div class="form-group row">
                    <div class="col-md-3">
                        <nop-label asp-for="TestWebhookSecret" />
                    </div>
                    <div class="col-md-9">
                        <nop-editor asp-for="TestWebhookSecret" asp-required="false" />
                        @if (Model.TestWebhookSecretConfigured)
                        {
                            <span class="text-success">Configured</span>
                        }
                        else
                        {
                            <span class="text-warning">Not configured</span>
                        }
                        <span class="text-muted">Leave blank to retain the saved test signing secret.</span>
                    </div>
                </div>
                <div class="form-group row">
                    <div class="col-md-3">
                        <nop-label asp-for="TestWebhookEndpointUrl" />
                    </div>
                    <div class="col-md-9">
                        <input asp-for="TestWebhookEndpointUrl" class="form-control" readonly="readonly" />
                    </div>
                </div>
                <div class="form-group row">
                    <div class="col-md-3">
                        <nop-label asp-for="TestWebhookEndpointId" />
                    </div>
                    <div class="col-md-9">
                        <input asp-for="TestWebhookEndpointId" class="form-control" readonly="readonly" />
                    </div>
                </div>
               
                <hr />
                <p>@T("Plugins.Payments.Stripe.VirtualPosInfo")</p>
                <div class="form-group row">
                    <div class="col-md-3">
                        <nop-override-store-checkbox asp-for="IsCardStorage_OverrideForStore" asp-input="IsCardStorage" asp-store-scope="@Model.ActiveStoreScopeConfiguration" />
                        <nop-label asp-for="IsCardStorage" />
                    </div>
                    <div class="col-md-9">
                        <nop-editor asp-for="IsCardStorage" />
                        <span asp-validation-for="IsCardStorage"></span>
                    </div>
                </div>
                
                <div class="form-group row">
                    <div class="col-md-9 offset-md-3">
                        <button type="submit" name="save" class="btn btn-primary">@T("Admin.Common.Save")</button>
                    </div>
                </div>
            </div>
        </div>
    </div>
</form>

<form asp-controller="PaymentStripe" asp-action="SyncWebhook" method="post">
    @Html.AntiForgeryToken()
    <div class="cards-group">
        <div class="card card-default">
            <div class="card-body">
                <p>
                    Synchronize the exact endpoint URL and required PaymentIntent events with Stripe. Existing duplicate endpoints are reported, not deleted.
                </p>
                <button type="submit" class="btn btn-secondary">Create / sync Stripe webhook</button>
            </div>
        </div>
    </div>
</form>
