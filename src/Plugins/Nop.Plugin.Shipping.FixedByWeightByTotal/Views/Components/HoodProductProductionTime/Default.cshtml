@model Nop.Plugin.Shipping.FixedByWeightByTotal.Models.ProductionTime.ProductProductionTimeModel
@{
    var min = Math.Max(0, Model.ProductionMinDays);
    var max = Math.Max(min, Model.ProductionMaxDays);
    var transitMin = 3;
    var transitMax = 5;
    var totalMin = min + transitMin;
    var totalMax = max + transitMax;
    var estimatedStart = DateTime.Today.AddDays(totalMin);
    var estimatedEnd = DateTime.Today.AddDays(totalMax);
    var culture = System.Globalization.CultureInfo.CurrentUICulture;
    string estimatedDateText;
    if (estimatedStart.Date == estimatedEnd.Date)
    {
        estimatedDateText = estimatedStart.ToString("MMM d, yyyy", culture);
    }
    else if (estimatedStart.Year == estimatedEnd.Year && estimatedStart.Month == estimatedEnd.Month)
    {
        estimatedDateText = $"{estimatedStart.ToString("MMM d", culture)} - {estimatedEnd.ToString("d, yyyy", culture)}";
    }
    else if (estimatedStart.Year == estimatedEnd.Year)
    {
        estimatedDateText = $"{estimatedStart.ToString("MMM d", culture)} - {estimatedEnd.ToString("MMM d, yyyy", culture)}";
    }
    else
    {
        estimatedDateText = $"{estimatedStart.ToString("MMM d, yyyy", culture)} - {estimatedEnd.ToString("MMM d, yyyy", culture)}";
    }
    var id = $"hood-production-time-{Model.ProductId}";
}
@if (Model.Enabled && Model.DisplayOnProductPage && max > 0)
{
    <style>
        .product-details-page .overview .hood-production-time-card {
            clear: both;
            box-sizing: border-box;
            width: 100%;
            margin: 0 0 18px;
            border: 1px solid #e9e5dc;
            border-left: 4px solid #007c5a;
            background: #fffdf8;
            padding: 13px 15px 12px;
            text-align: left;
            line-height: 1.45;
            color: #555;
            font-size: 13px;
            box-shadow: 0 1px 0 rgba(0,0,0,.03);
        }
        .product-details-page .overview .hood-production-time-card * {
            box-sizing: border-box;
        }
        .product-details-page .overview .hood-production-time-card .hood-production-time-title {
            display: flex;
            align-items: center;
            gap: 8px;
            margin: 0 0 10px;
            font-size: 14px;
            line-height: 20px;
            font-weight: 700;
            color: #333;
            text-transform: uppercase;
            letter-spacing: .2px;
        }
        .product-details-page .overview .hood-production-time-card .hood-production-time-icon {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            flex: 0 0 24px;
            width: 24px;
            height: 24px;
            border-radius: 50%;
            background: rgba(0, 124, 90, .09);
            color: #007c5a;
        }
        .product-details-page .overview .hood-production-time-card .hood-production-time-icon svg {
            width: 15px;
            height: 15px;
            display: block;
        }
        .product-details-page .overview .hood-production-time-card .hood-production-time-pill {
            margin-left: auto;
            padding: 2px 8px;
            border: 1px solid #e8e1d4;
            border-radius: 999px;
            color: #777;
            background: #fff;
            font-size: 11px;
            font-weight: 400;
            text-transform: none;
            letter-spacing: 0;
            white-space: nowrap;
        }
        .product-details-page .overview .hood-production-time-card .hood-production-time-grid {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 8px;
        }
        .product-details-page .overview .hood-production-time-card .hood-production-time-item {
            border: 1px solid #eee8dd;
            background: #fff;
            padding: 8px 10px;
            min-height: 54px;
        }
        .product-details-page .overview .hood-production-time-card .hood-production-time-label {
            display: block;
            margin: 0 0 3px;
            color: #777;
            font-size: 11px;
            line-height: 15px;
        }
        .product-details-page .overview .hood-production-time-card .hood-production-time-value {
            display: block;
            color: #333;
            font-size: 14px;
            line-height: 18px;
            font-weight: 700;
        }
        .product-details-page .overview .hood-production-time-card .hood-production-time-note {
            margin: 9px 0 0;
            color: #777;
            font-size: 12px;
            line-height: 18px;
        }
        .product-details-page .overview .hood-production-time-card .hood-production-time-note strong {
            color: #555;
            font-weight: 700;
        }
        .air-theme .product-details-page .overview .hood-production-time-card {
            border-left-color: #eda187;
        }
        .air-theme .product-details-page .overview .hood-production-time-card .hood-production-time-icon {
            background: rgba(237, 161, 135, .14);
            color: #d77b5d;
        }
        .earth-theme .product-details-page .overview .hood-production-time-card {
            border-left-color: #007c5a;
        }
        @@media all and (max-width: 720px) {
            .product-details-page .overview .hood-production-time-card {
                margin-bottom: 14px;
                padding: 12px;
            }
            .product-details-page .overview .hood-production-time-card .hood-production-time-grid {
                grid-template-columns: 1fr;
            }
            .product-details-page .overview .hood-production-time-card .hood-production-time-pill {
                display: none;
            }
        }
    </style>

    <div id="@id" class="hood-production-time-card" data-hood-production-time-card="true" data-product-id="@Model.ProductId">
        <div class="hood-production-time-title">
            <span class="hood-production-time-icon" aria-hidden="true">
                <svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                    <path d="M7.5 19.5h9" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" />
                    <path d="M8.7 16.8c1.8-3.2 4.2-6.7 8.1-10.6.5-.5 1.3-.5 1.8 0l.2.2c.5.5.5 1.3 0 1.8-3.9 3.9-7.4 6.3-10.6 8.1l-.9.5.5-.9Z" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round" />
                    <path d="M6.7 17.3c-.9.5-1.7.7-2.2.2-.6-.6-.2-1.9.9-3" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" />
                    <path d="M14.9 8.1l1 1" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" />
                </svg>
            </span>
            <span>Handmade production time</span>
            @if (Model.IsHandmade)
            {
                <span class="hood-production-time-pill">Made to order</span>
            }
        </div>
        <div class="hood-production-time-grid">
            <div class="hood-production-time-item">
                <span class="hood-production-time-label">Production time</span>
                <span class="hood-production-time-value">@Model.EffectiveProductionText</span>
            </div>
            <div class="hood-production-time-item">
                <span class="hood-production-time-label">Estimated delivery date</span>
                <span class="hood-production-time-value">@estimatedDateText</span>
            </div>
        </div>
        <div class="hood-production-time-note">
            <strong>Express shipping starts after production.</strong> The delivery date above shows shipping transit only.
        </div>
    </div>

    <script>
        (function () {
            var card = document.getElementById('@id');
            if (!card) return;

            var overview = card.closest('.overview');
            if (!overview) return;

            var delivery = overview.querySelector('.delivery');
            if (delivery && delivery.parentNode === overview && delivery.nextSibling !== card) {
                delivery.insertAdjacentElement('afterend', card);
            }
        })();
    </script>
}
