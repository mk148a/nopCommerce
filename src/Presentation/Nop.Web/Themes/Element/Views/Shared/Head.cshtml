@using Nop.Core
@using Nop.Core.Domain.Catalog
@using Nop.Services.Configuration

@inject CatalogSettings catalogSettings
@inject IWorkContext workContext
@inject ISettingService settingService
@inject IStoreContext storeContext

@{
    var supportRtl = (await workContext.GetWorkingLanguageAsync()).Rtl;
    var currentStore = await storeContext.GetCurrentStoreAsync();
    var storeId = currentStore?.Id ?? 0;
    var gtmEnabled = await settingService.GetSettingByKeyAsync("googletagmanagersettings.isenable", false, storeId, true);

    if (supportRtl)
    {
        NopHtml.AppendCssFileParts("~/Themes/Element/Content/css/1320.rtl.css");
        NopHtml.AppendCssFileParts("~/Themes/Element/Content/css/1024.rtl.css");
        NopHtml.AppendCssFileParts("~/Themes/Element/Content/css/720.rtl.css");
        NopHtml.AppendCssFileParts("~/Themes/Element/Content/css/480.rtl.css");
        NopHtml.AppendCssFileParts("~/Themes/Element/Content/css/mobile.rtl.css");
        NopHtml.AppendCssFileParts("~/Themes/Element/Content/css/styles.rtl.css");
    }
    else
    {
        NopHtml.AppendCssFileParts("~/Themes/Element/Content/css/1320.css");
        NopHtml.AppendCssFileParts("~/Themes/Element/Content/css/1024.css");
        NopHtml.AppendCssFileParts("~/Themes/Element/Content/css/720.css");
        NopHtml.AppendCssFileParts("~/Themes/Element/Content/css/480.css");
        NopHtml.AppendCssFileParts("~/Themes/Element/Content/css/mobile.css");
        // WebOptimizer fingerprints this source in the generated bundle; keep the source path query-free.
        NopHtml.AppendCssFileParts("~/Themes/Element/Content/css/styles.css");
    }

    // Isolate the pointer-interception fix in a versioned source asset so browsers
    // with a cached theme stylesheet receive the correction immediately.
    NopHtml.AppendCssFileParts("~/Themes/Element/Content/css/review-pointer-fix.css", excludeFromBundle: true);

    // Keep catalog-card metadata rules outside the long-lived theme bundle so
    // title truncation and visible review counts are picked up without a stale
    // cached styles.css file.
    NopHtml.AppendCssFileParts("~/Themes/Element/Content/css/catalog-card-meta.css?v=140b5e665c", excludeFromBundle: true);

    NopHtml.AppendCssFileParts("~/Themes/Element/Content/css/hood-third-party-gate-v6.css?v=660", excludeFromBundle: true);
    NopHtml.AppendCssFileParts("~/Themes/Element/Content/css/hood-v9-report-fixes.css?v=920", excludeFromBundle: true);

    if (catalogSettings.DisplayAllPicturesOnCatalogPages)
    {
        NopHtml.AppendCssFileParts("~/lib_npm/swiper/swiper-bundle.min.css");
    }

    NopHtml.AppendCssFileParts("~/Plugins/SevenSpikes.Core/Styles/perfect-scrollbar.min.css");

    <script src="~/Plugins/SevenSpikes.Core/Scripts/footable.min.js" asp-location="Footer"></script>
    <script src="~/Plugins/SevenSpikes.Core/Scripts/perfect-scrollbar.min.js" asp-location="Footer"></script>
    <script src="~/Plugins/SevenSpikes.Core/Scripts/sevenspikes.core.min.js" asp-location="Footer"></script>
    <script src="~/Plugins/SevenSpikes.Core/Scripts/sevenspikes.theme.ex.min.js" asp-location="Footer"></script>

    <script src="~/Themes/Element/Content/scripts/element.js" asp-location="Footer"></script>
    <script src="~/Themes/Element/Content/scripts/hood-third-party-gate-v6.js?v=661" asp-location="Footer"></script>
    <script src="~/Themes/Element/Content/scripts/hood-v9-report-fixes.js?v=920" asp-location="Footer"></script>
    @if (gtmEnabled)
    {
        @* The NopStation event client is loaded only when its widget did not
           already add the same script tag. The country gate still owns the
           configured GTM container load, so this bridge cannot create a second
           GTM container or a second page view. *@
        <script asp-location="Footer">
            (function () {
                function ensureNopStationEventClient() {
                    if (document.querySelector('script[src*="/NopStation.Plugin.Widgets.GoogleTagManager/Content/js/ns.gtm.js"]'))
                        return;

                    if (!document.querySelector('.page_type_gtm')) {
                        var marker = document.createElement('div');
                        marker.className = 'page_type_gtm';
                        marker.style.display = 'none';
                        var body = document.body;
                        marker.setAttribute('data-page-type', body && body.classList.contains('html-product-page') ? 'Product' :
                            (body && body.classList.contains('html-category-page') ? 'Category' : 'home'));
                        (body || document.documentElement).appendChild(marker);
                    }

                    var script = document.createElement('script');
                    script.async = false;
                    script.src = '/Plugins/NopStation.Plugin.Widgets.GoogleTagManager/Content/js/ns.gtm.js';
                    (document.body || document.documentElement).appendChild(script);
                }

                window.setTimeout(ensureNopStationEventClient, 0);
            })();
        </script>
    }
    @* Keep the existing lazy Tawk loader guarded against duplicate embed loads. *@
    <script src="~/Themes/Element/Content/scripts/hood-v10-8-1-tawk-stable-fix.js?v=1081" asp-location="Footer"></script>
}
