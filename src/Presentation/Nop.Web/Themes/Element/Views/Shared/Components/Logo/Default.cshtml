@using Nop.Core
@using Nop.Services.Localization
@using Nop.Web.Framework.Themes

@model LogoModel

@inject IThemeContext themeContext
@inject IStoreContext storeContext
@inject ILocalizationService localizationService

@{
    // Keep the same high-resolution WebP as the fallback; the theme's bundled
    // sample logo is unrelated to Hood Archery Shop.
    var fallbackLogoPath = Url.Content("~/images/0003417_0.webp");
    // The active store logo was uploaded as a 100px PNG and is visibly soft when
    // enlarged to the reserved 150px header slot. Use the retained 300px WebP
    // for that legacy asset while leaving other configurable store logos intact.
    var logoPath = Model.LogoPath;
    if (String.IsNullOrWhiteSpace(logoPath) ||
        logoPath.Contains("0003403_1000094787", StringComparison.OrdinalIgnoreCase))
    {
        logoPath = Url.Content("~/images/0003417_0.webp");
    }
    var storeName = await localizationService.GetLocalizedAsync(await storeContext.GetCurrentStoreAsync(), x => x.Name);
}

<a href="@Url.RouteUrl("Homepage")" class="logo">
    <img class="store-logo" title="" alt="@storeName"
         width="150" height="150"
         loading="eager" decoding="async"
         fetchpriority="high"
         src="@logoPath"
         onerror="this.onerror=null;this.src='@fallbackLogoPath';">
</a>
