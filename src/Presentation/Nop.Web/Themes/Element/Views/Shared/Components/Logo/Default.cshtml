@using Nop.Core
@using Nop.Services.Localization
@using Nop.Web.Framework.Themes

@model LogoModel

@inject IThemeContext themeContext
@inject IStoreContext storeContext
@inject ILocalizationService localizationService

@{
    var themeLogoPath = $"~/Themes/{await themeContext.GetWorkingThemeNameAsync()}/Content/img/logo.png";
    var fallbackLogoPath = Url.Content(themeLogoPath);
    var storeName = await localizationService.GetLocalizedAsync(await storeContext.GetCurrentStoreAsync(), x => x.Name);
}

<a href="@Url.RouteUrl("Homepage")" class="logo">
    <img title="" alt="@storeName"
         width="150" height="150"
         loading="eager" decoding="async"
         src="@(String.IsNullOrWhiteSpace(Model.LogoPath) ? fallbackLogoPath : Model.LogoPath)"
         onerror="this.onerror=null;this.src='@fallbackLogoPath';">
</a>
